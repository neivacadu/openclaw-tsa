{
  "id": "tsa-ace-output-filter",
  "version": "1.0.0",
  "displayName": "TSA ACE Output Filter",
  "description": "Filtra output do agente 0-ace antes de enviar ao Telegram extraindo apenas o bloco <<ACE>>...<<END>> via message_sending hook",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "type": "string",
        "default": "0-ace"
      },
      "fallbackContent": {
        "type": "string",
        "default": "[ACE block ausente — verificar transcript]"
      }
    }
  }
}
