{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["./index.ts", "./src/**/*.ts", "./types/**/*.d.ts"],
  "exclude": ["dist", "node_modules", "_legacy-flat-format/**", "./**/*.test.ts.bak"]
}
